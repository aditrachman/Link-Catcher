rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Setiap pengguna hanya boleh mengakses kartu miliknya sendiri.
    match /users/{userId}/notes/{noteId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['summary', 'rawText', 'links', 'tags', 'mode', 'items', 'pinned', 'createdAt', 'updatedAt'])
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 3000
        && request.resource.data.rawText is string
        && request.resource.data.rawText.size() <= 100000
        && request.resource.data.links is list
        && request.resource.data.links.size() <= 300
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 8
        && request.resource.data.mode in ['prose', 'list']
        && (request.resource.data.items == null || request.resource.data.items is list)
        && request.resource.data.pinned is bool
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;
    }
  }
}
